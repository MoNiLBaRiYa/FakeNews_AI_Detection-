{
  "manifest_version": 3,
  "name": "TruthGuard AI Verifier",
  "version": "1.0.0",
  "description": "Analyze selected text or articles for misinformation using TruthGuard AI.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://*.truthguard.ai/*"
  ],
  "action": {
    "default_title": "TruthGuard AI Verifier",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
